<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/paperrugged"
    tools:context=".MainActivity">

    <View
        android:id="@+id/divisorLine"
        android:layout_width="wrap_content"
        android:layout_height="5dp"
        android:background="#070000"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="333dp" />

    <ImageView
        android:id="@+id/rockAI_id"
        android:layout_width="112dp"
        android:layout_height="113dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/paperAI_id"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/question" />

    <ImageView
        android:id="@+id/paperAI_id"
        android:layout_width="112dp"
        android:layout_height="113dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="150dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/question" />

    <ImageView
        android:id="@+id/scissoresAi_id"
        android:layout_width="112dp"
        android:layout_height="113dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toEndOf="@+id/paperAI_id"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/question" />

    <ImageView
        android:id="@+id/scissorsPlayer_id"
        android:layout_width="130dp"
        android:layout_height="166dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/paperPlayer_id"
        app:layout_constraintTop_toTopOf="@+id/paperPlayer_id"
        app:srcCompat="@drawable/scissors" />

    <ImageView
        android:id="@+id/paperPlayer_id"
        android:layout_width="137dp"
        android:layout_height="162dp"
        android:layout_marginStart="128dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/paper1" />

    <ImageView
        android:id="@+id/rockPlayer_id"
        android:layout_width="122dp"
        android:layout_height="162dp"
        app:layout_constraintEnd_toStartOf="@+id/paperPlayer_id"
        app:layout_constraintTop_toTopOf="@+id/paperPlayer_id"
        app:srcCompat="@drawable/rock" />

    <ImageView
        android:id="@+id/playerBox_id"
        android:layout_width="355dp"
        android:layout_height="170dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toTopOf="@+id/paperPlayer_id"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/winner" />

    <ImageView
        android:id="@+id/aiBox_id"
        android:layout_width="355dp"
        android:layout_height="170dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/paperAI_id"
        app:srcCompat="@drawable/loser" />

    <ImageView
        android:id="@+id/countDown_id"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginStart="52dp"
        android:layout_marginBottom="244dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/number1" />

</androidx.constraintlayout.widget.ConstraintLayout>